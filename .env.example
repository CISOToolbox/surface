# ───────────────────────────────────────────────────────────────
# Surface (standalone) — environment configuration
# Copy to `.env` and edit the values.
# ───────────────────────────────────────────────────────────────

# PostgreSQL credentials (internal, used by the docker-compose DB)
DB_PASSWORD=change-me

# ROOT secret, not a signing key. Surface derives its own session signing
# key from it at startup:
#   HKDF-SHA256(JWT_SECRET, info="ciso-module:surface")
# so the raw secret never signs anything and a session minted by another
# module cannot be replayed here. Changing this value rotates the key and
# logs every user out. Use a long random string (`openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# Data-at-rest key for the per-target SMB credentials saved from the UI
# (smb_scan add-on). REQUIRED — docker compose refuses to start without it,
# and it must be a DEDICATED value distinct from JWT_SECRET (SEC-01: no more
# silent fallback coupling the session and data-at-rest trust domains).
# >= 32 chars. Rotating it requires re-entering the stored credentials.
#   openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-dedicated-random-string

# Public URL the app is reachable at. Must match the host your users type
# in their browser. Used to build OAuth/OIDC redirect URIs (e.g.
# ${APP_URL}/auth/callback/entra) and to decide the `Secure` flag on the
# session cookie. Fail-secure (AUTH-05): the cookie is Secure unless this
# URL explicitly starts with `http://` — an empty or malformed value no
# longer silently downgrades the session.
APP_URL=http://localhost:8087

# ── Authentication providers (optional — configure any combination) ──
# At least one provider must be configured, otherwise the app boots
# unauthenticated only if you explicitly set SURFACE_ALLOW_NO_AUTH=1.

# Token login (legacy): share a pre-shared secret with the operator.
# The first user that logs in becomes admin; subsequent users are plain
# users that an admin must promote.
# AUTH_TOKEN=change-me-to-a-long-random-token

# Comma-separated list of email domains allowed to sign in through an identity
# provider (e.g. "example.com,example.org"). Leave empty to accept any domain
# the IdP authenticates. Independent of the approval workflow: whatever passes
# this list still lands as "pending" until an admin promotes it, so an external
# Google client cannot turn any Gmail address into an active account.
ALLOWED_EMAIL_DOMAINS=

# Microsoft Entra ID / M365
# Register an app at https://entra.microsoft.com → App registrations
# and add ${APP_URL}/auth/callback/entra as a redirect URI.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=common        # or your tenant GUID

# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
# and add ${APP_URL}/auth/callback/google as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Generic OIDC provider (Keycloak, Authentik, Authelia, Zitadel, …)
# The issuer must expose /.well-known/openid-configuration. Register the
# callback URI ${APP_URL}/auth/callback/oidc in the provider.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://sso.example.com/realms/main
# OIDC_LABEL=SSO                 # display name of the button on the login page

# Dev-only escape hatch — disable auth entirely. DO NOT set in production.
# SURFACE_ALLOW_NO_AUTH=1

# ── Optional: outbound HTTP proxy (corporate egress) ───────────
# For hosts with NO direct internet access that must reach outbound
# services (the LLM API; for Surface also the CVE feeds and scan probes)
# through a corporate forward proxy. When set, httpx routes EVERY
# outbound call this backend makes through the proxy — it reads these
# from the environment at request time, so no code change is needed.
# The PostgreSQL connection uses asyncpg (not httpx) and is NEVER proxied.
# NO_PROXY lists hosts to reach directly (bypassing the proxy).
# Leave all three empty for direct outbound access (the default).
#   HTTP_PROXY=http://proxy.corp.example:8080
#   HTTPS_PROXY=http://proxy.corp.example:8080
#   NO_PROXY=localhost,127.0.0.1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
